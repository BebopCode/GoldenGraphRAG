# --- PostgreSQL / Apache AGE ---
POSTGRES_USER=kg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AGE_GRAPH_NAME=kg_graph

# --- Ollama (runs on host) ---
OLLAMA_HOST=http://localhost:11434
# Default below; pull a local model with `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# --- App ---
ONTOLOGY_PATH=config/ontologies/generic.yaml
CHUNKER=structural            # structural | fixed
LOG_LEVEL=INFO

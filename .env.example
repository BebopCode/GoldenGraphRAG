# --- PostgreSQL / Apache AGE ---
POSTGRES_USER=kg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AGE_GRAPH_NAME=kg_graph

# --- LLM (any OpenAI-compatible endpoint) ---
# provider picks preset defaults for base_url/model; explicit values below win.
#   openrouter | vllm | openai | together | fireworks | litellm | ollama
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-30b-a3b-instruct

# --- LLM tuning (defaults shown; uncomment a line to override) ---
# LLM_TIMEOUT=120        # per-request timeout in seconds; raise for slow
#                        # reasoning models (they think before answering).
# LLM_MAX_RETRIES=2      # retries per request on timeout / connection drops /
#                        # 429 / 5xx, backing off 1/2/4/8s. A rate-limit window
#                        # can take ~60s to refill, so pair more retries with
#                        # lower concurrency, not higher.
# LLM_CONCURRENCY=2      # parallel chunk extractions. Stay LOW on hosted APIs:
#                        # they cap tokens-per-minute by spend tier, each
#                        # extraction burns ~1-3k tokens (ontology prompt +
#                        # chunk + JSON output), and high concurrency drains
#                        # the budget in seconds -> 429 storm -> retries exhaust
#                        # -> chunks get SKIPPED (a silently incomplete graph).
#                        # 2 stays under most tiers' refill rate. Raise only on
#                        # self-hosted endpoints (vLLM etc.) with no token cap.
# LLM_STRUCTURED_MODE=auto   # auto | json_schema | json_object | none. auto asks
#                        # for schema-constrained output once and degrades if the
#                        # endpoint rejects it; pin a mode to skip the probe.
# LLM_MAX_TOKENS=        # cap output tokens; unset = provider default. Raise if
#                        # you see finish_reason=length warnings (truncated JSON).
# LLM_ALLOWED_PROVIDERS= # OpenRouter routing allowlist, comma-separated (e.g.
#                        # Groq,DeepInfra), keeps prompts off unapproved vendors.
# LLM_HTTP_REFERER=      # sent as the HTTP-Referer header (OpenRouter attribution).

# Local Ollama instead of a hosted provider (model pulled via `ollama pull`):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1     # note the /v1

# --- App ---
ONTOLOGY_PATH=config/ontologies/generic.yaml
CHUNKER=fixed                 # fixed | structural
LOG_LEVEL=INFO

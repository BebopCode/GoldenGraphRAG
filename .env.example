# --- PostgreSQL / Apache AGE ---
POSTGRES_USER=kg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AGE_GRAPH_NAME=kg_graph

# --- LLM (any OpenAI-compatible endpoint) ---
# provider picks preset defaults for base_url/model; explicit values below win.
#   openrouter | vllm | openai | together | fireworks | litellm | ollama
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-30b-a3b-instruct

# Optional tuning (defaults shown)
# LLM_TIMEOUT=120              # per-request timeout, seconds
# LLM_MAX_RETRIES=2            # SDK-level retries with backoff
# LLM_CONCURRENCY=8            # parallel chunk extractions (4-8 on OpenRouter)
# LLM_STRUCTURED_MODE=auto     # auto | json_schema | json_object | none
# LLM_MAX_TOKENS=              # cap output tokens (leave unset for provider default)
# LLM_ALLOWED_PROVIDERS=       # OpenRouter routing allowlist, comma-separated

# Local Ollama instead of a hosted provider (model pulled via `ollama pull`):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1     # note the /v1

# --- App ---
ONTOLOGY_PATH=config/ontologies/generic.yaml
CHUNKER=fixed                 # fixed | structural
LOG_LEVEL=INFO
